<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>UpDesk - Login</title>
</head>
<body>
  <h2>UpDesk - Entrar</h2>
  <form action="/autenticacao/login" method="POST">
    <div>
      <label>E-mail:</label>
      <input type="email" name="email" required>
    </div>
    <div>
      <label>Senha:</label>
      <input type="password" name="senha" required>
    </div>
    <button type="submit">Entrar</button>
  </form>
  <p><a href="/autenticacao/cadastro">Não tem conta? Cadastre-se</a></p>
</body>
</html>