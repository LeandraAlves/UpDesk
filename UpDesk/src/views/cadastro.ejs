<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Cadastro - UpDesk</title>
</head>
<body>

  <div class="card-cadastro">
    <h2>Cadastro</h2>

    <form action="/autenticacao/cadastrar" method="POST">
      <div>
        <input type="text" name="nome" placeholder="Nome" required>
      </div>
      <div>
        <input type="email" name="email" placeholder="E-mail" required>
      </div>
      <div>
        <input type="password" name="senha" placeholder="Senha" required>
      </div>
      
      <!-- O campo de seleção de perfil foi removido. 
           Agora todo registo público é automaticamente 'cliente'. -->

      <div>
        <a href="/autenticacao/login">Cancelar</a>
        <button type="submit">Cadastrar</button>
      </div>
    </form>
  </div>

</body>
</html>