<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meus Chamados - UpDesk</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { paginaAtiva: 'chamados' }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar') %>

      <main class="content-area">
        <div class="page-header">
          <div>
            <h1 class="page-title">Meus Chamados</h1>
            <p class="page-subtitle">Acompanhe, filtre e gerencie todos os chamados da empresa.</p>
          </div>
          <button type="button" class="btn btn-primary" onclick="document.getElementById('cardNovoChamado').style.display = document.getElementById('cardNovoChamado').style.display === 'none' ? 'block' : 'none'">
            + Novo Chamado
          </button>
        </div>

        <!-- Formulário Novo Chamado -->
        <div id="cardNovoChamado" class="card" style="display: none; border-left: 4px solid #1a73e8;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2 class="card-title" style="margin-bottom:0;">Novo Chamado</h2>
            <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('cardNovoChamado').style.display='none'">✕ Fechar</button>
          </div>

          <form action="/chamados/cadastrar" method="POST">
            <div class="form-group">
              <label class="form-label">Título <span class="req">*</span></label>
              <input type="text" name="titulo" class="form-control" placeholder="Descreva o problema de forma resumida" required>
            </div>

            <div class="form-group">
              <label class="form-label">Descrição <span class="req">*</span></label>
              <textarea name="descricao" class="form-control" placeholder="Descreva o problema em detalhes..." required></textarea>
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label class="form-label">Categoria</label>
                <select name="categoriaId" class="form-control">
                  <option value="">Selecione uma categoria</option>
                  <% if (typeof categorias !== 'undefined') { %>
                    <% categorias.forEach(cat => { %>
                      <option value="<%= cat.id %>"><%= cat.nome %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">Departamento</label>
                <select name="departamentoId" class="form-control">
                  <option value="">Selecione um departamento</option>
                  <% if (typeof departamentos !== 'undefined') { %>
                    <% departamentos.forEach(dep => { %>
                      <option value="<%= dep.id %>"><%= dep.nome %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">Prioridade</label>
                <select name="prioridade" class="form-control">
                  <option value="baixa">Baixa</option>
                  <option value="media" selected>Média</option>
                  <option value="alta">Alta</option>
                </select>
              </div>

            </div>

            <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:16px;">
              <button type="button" class="btn btn-secondary" onclick="document.getElementById('cardNovoChamado').style.display='none'">Cancelar</button>
              <button type="submit" class="btn btn-primary">Abrir Chamado</button>
            </div>
          </form>
        </div>

        <!-- Tabela de Chamados -->
        <div class="card">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Título</th>
                  <th>Solicitante</th>
                  <th>Categoria</th>
                  <th>Departamento</th>
                  <th>Status</th>
                  <th>Prioridade</th>
                  <th>Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof chamados !== 'undefined' && chamados.length > 0) { %>
                  <% chamados.forEach(c => { %>
                    <tr>
                      <td><strong>#<%= String(c.id).padStart(3, '0') %></strong></td>
                      <td><strong><%= c.titulo %></strong></td>
                      <td><%= c.solicitante ? c.solicitante.nome : '-' %></td>
                      <td><%= c.categoria ? c.categoria.nome : '-' %></td>
                      <td><%= c.departamento ? c.departamento.nome : '-' %></td>
                      <td>
                        <% if (c.status === 'aberto') { %>
                          <span class="badge badge-info">Aberto</span>
                        <% } else if (c.status === 'em_andamento') { %>
                          <span class="badge badge-success">Em andamento</span>
                        <% } else { %>
                          <span class="badge badge-neutral">Fechado</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (c.prioridade === 'alta') { %>
                          <span class="badge badge-danger">Alta</span>
                        <% } else if (c.prioridade === 'media') { %>
                          <span class="badge badge-warning">Média</span>
                        <% } else { %>
                          <span class="badge badge-success">Baixa</span>
                        <% } %>
                      </td>
                      <td>
                        <a href="/chamados/editar/<%= c.id %>" class="btn btn-secondary btn-sm">Detalhes</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="8" style="text-align: center; padding: 40px; color: #64748b;">
                      Nenhum chamado registado até o momento.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
