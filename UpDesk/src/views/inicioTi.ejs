<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel TI - UpDesk</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { paginaAtiva: 'ti' }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar') %>

      <main class="content-area">
        <div class="page-header">
          <div>
            <h1 class="page-title">Painel do Setor de TI</h1>
            <p class="page-subtitle">Chamados em aberto solicitados pelos clientes.</p>
          </div>
          <a href="/ti/chamados-abertos" class="btn btn-primary">🔄 Atualizar Fila</a>
        </div>

        <div class="card">
          <h2 class="card-title">Chamados em Aberto (Clientes)</h2>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Título</th>
                  <th>Cliente (Solicitante)</th>
                  <th>Prioridade</th>
                  <th>Status</th>
                  <th>Data</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof chamadosAbertos !== 'undefined' && chamadosAbertos.length > 0) { %>
                  <% chamadosAbertos.forEach(c => { %>
                    <tr>
                      <td><strong>#<%= String(c.id).padStart(3, '0') %></strong></td>
                      <td><strong><%= c.titulo %></strong></td>
                      <td><%= c.solicitante ? c.solicitante.nome : 'Desconhecido' %></td>
                      <td>
                        <% if (c.prioridade === 'alta') { %>
                          <span class="badge badge-danger">Alta</span>
                        <% } else if (c.prioridade === 'media') { %>
                          <span class="badge badge-warning">Média</span>
                        <% } else { %>
                          <span class="badge badge-success">Baixa</span>
                        <% } %>
                      </td>
                      <td><span class="badge badge-info"><%= c.status %></span></td>
                      <td><%= c.createdAt ? c.createdAt.toLocaleDateString('pt-BR') : '-' %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 36px; color: #64748b;">
                      Nenhum chamado em aberto no momento.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
