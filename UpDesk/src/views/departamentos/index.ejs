<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Departamentos - UpDesk</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { paginaAtiva: 'departamentos' }) %>

    <div class="main-wrapper">
      <%- include('../partials/topbar') %>

      <main class="content-area">
        <div class="page-header">
          <div>
            <h1 class="page-title">Departamentos</h1>
            <p class="page-subtitle">Gerencie os departamentos da empresa para organização dos chamados.</p>
          </div>
        </div>
        <% if (erro) { %>
          <div class="card" role="alert" style="border-left:4px solid #dc2626; color:#b91c1c; margin-bottom:16px;">
            <%= erro %>
          </div>
        <% } %>
        <% if (sucesso === 'criado' || sucesso === 'editado' || sucesso === 'excluido') { %>
          <div class="card" role="status" style="border-left:4px solid #16a34a; color:#15803d; margin-bottom:16px;">
            <%= sucesso === 'criado' ? 'Departamento criado com sucesso.' : (sucesso === 'editado' ? 'Departamento atualizado com sucesso.' : 'Departamento excluído com sucesso.') %>
          </div>
        <% } %>
        <div class="split-grid">
          <!-- Lista de Departamentos (Esquerda) -->
          <div class="card">
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Nome do Departamento</th>
                    <th>Descrição</th>
                    <th>Status</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof departamentos !== 'undefined' && departamentos.length > 0) { %>
                    <% departamentos.forEach(dep => { %>
                      <tr>
                        <td><%= dep.id %></td>
                        <td>
                          <form id="departamento-editar-<%= dep.id %>" action="/departamentos/editar/<%= dep.id %>" method="POST">
                            <input type="text" name="nome" class="form-control" value="<%= dep.nome %>" maxlength="255" aria-label="Nome do departamento" required>
                          </form>
                        </td>
                        <td>
                          <input type="text" name="descricao" form="departamento-editar-<%= dep.id %>" class="form-control" value="<%= dep.descricao || '' %>" maxlength="255" aria-label="Descrição do departamento">
                        </td>
                        <td><span class="badge badge-success">Ativo</span></td>
                        <td>
                          <div style="display:flex; gap:8px; align-items:center;">
                            <button type="submit" form="departamento-editar-<%= dep.id %>" class="btn btn-secondary btn-sm">Salvar</button>
                            <form action="/departamentos/excluir/<%= dep.id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este departamento?')">
                              <button type="submit" class="btn-danger-icon">🗑️ Excluir</button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" style="text-align:center; padding:32px; color:#64748b;">Nenhum departamento cadastrado.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Painel Lateral Novo Departamento (Direita) -->
          <div class="card" style="border-top: 4px solid #1a73e8;">
            <h2 class="card-title">Novo Departamento</h2>
            <form action="/departamentos/novo" method="POST">
              <div class="form-group">
                <label class="form-label">Nome do Departamento <span class="req">*</span></label>
                <input type="text" name="nome" class="form-control" placeholder="Digite o nome do departamento" maxlength="255" value="<%= formulario.nome %>" required>
              </div>
              <div class="form-group">
                <label class="form-label">Descrição</label>
                <textarea name="descricao" class="form-control" maxlength="255" placeholder="Descreva o departamento..."><%= formulario.descricao %></textarea>
              </div>

              <div style="display:flex; gap:12px; margin-top:24px;">
                <button type="reset" class="btn btn-secondary" style="flex:1;">Limpar</button>
                <button type="submit" class="btn btn-primary" style="flex:1;">💾 Salvar</button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
