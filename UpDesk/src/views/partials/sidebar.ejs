<aside class="sidebar">
  <div class="brand-logo">
    <span class="logo-icon">🎧</span>
    <div><span class="accent">Up</span>Desk</div>
  </div>

  <nav class="nav-menu">
    <% const rotaAtiva = typeof paginaAtiva !== 'undefined' ? paginaAtiva : ''; %>
    <% const perfilUser = (typeof usuario !== 'undefined' && usuario) ? usuario.perfil : 'admin'; %>

    <% if (perfilUser === 'admin' || perfilUser === 'gerencia') { %>
      <a href="/inicio" class="nav-item <%= rotaAtiva === 'inicio' ? 'active' : '' %>">
        <span>🏠</span> Início
      </a>
    <% } %>
    <% if (perfilUser === 'tecnico') { %>
      <a href="/ti" class="nav-item <%= rotaAtiva === 'inicio-ti' ? 'active' : '' %>">
        <span>🏠</span> Início
      </a>
    <% } %>

    <a href="/chamados" class="nav-item <%= rotaAtiva === 'chamados' ? 'active' : '' %>">
      <span>📋</span> <%= perfilUser === 'tecnico' ? 'Chamados atribuídos' : (['admin', 'gerencia'].includes(perfilUser) ? 'Todos os chamados' : 'Meus Chamados') %>
    </a>
    <% if (perfilUser !== 'tecnico') { %>
      <a href="/chamados/novo" class="nav-item <%= rotaAtiva === 'novo-chamado' ? 'active' : '' %>">
        <span>＋</span> Novo Chamado
      </a>
    <% } %>

    <% if (perfilUser === 'admin' || perfilUser === 'tecnico') { %>
      <a href="/ti/chamados-abertos" class="nav-item <%= rotaAtiva === 'ti' ? 'active' : '' %>">
        <span>📊</span> Fila de atendimento
      </a>
    <% } %>
    <% if (perfilUser === 'tecnico') { %>
      <a href="/ti/equipe" class="nav-item <%= rotaAtiva === 'equipe' ? 'active' : '' %>">
        <span>👥</span> Equipe
      </a>
      <a href="/auditoria" class="nav-item <%= rotaAtiva === 'auditoria' ? 'active' : '' %>">
        <span>🧾</span> Acompanhamento
      </a>
    <% } %>
    <% if (perfilUser === 'admin') { %>
      <a href="/ti/desempenho" class="nav-item <%= rotaAtiva === 'desempenho' ? 'active' : '' %>">
        <span>📈</span> Desempenho
      </a>
      <a href="/auditoria" class="nav-item <%= rotaAtiva === 'auditoria' ? 'active' : '' %>">
        <span>🧾</span> Acompanhamento
      </a>
      <a href="/categorias" class="nav-item <%= rotaAtiva === 'categorias-chamado' ? 'active' : '' %>">
        <span>🗂️</span> Categorias de chamados
      </a>
    <% } %>
    <% if (perfilUser === 'admin' || perfilUser === 'gerencia') { %>
      <a href="/departamentos" class="nav-item <%= rotaAtiva === 'departamentos' ? 'active' : '' %>">
        <span>🏢</span> Departamentos
      </a>
      <a href="/usuarios" class="nav-item <%= rotaAtiva === 'usuarios' ? 'active' : '' %>">
        <span>👥</span> Usuários
      </a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <form action="/autenticacao/logout" method="POST">
      <button type="submit" class="nav-item" style="width:100%; background:transparent; border:0; text-align:left; cursor:pointer; color:#fca5a5; font:inherit;">
        <span>🚪</span> Sair
      </button>
    </form>
  </div>
</aside>
<script src="/js/instant-forms.js" defer></script>
