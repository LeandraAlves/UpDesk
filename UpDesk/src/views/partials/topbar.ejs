<header class="topbar">
  <% const nomeUser = (typeof usuario !== 'undefined' && usuario && usuario.nome) ? usuario.nome : 'Usuário'; %>
  <% const perfilUser = (typeof usuario !== 'undefined' && usuario && usuario.perfil) ? usuario.perfil : 'admin'; %>
  <% const perfilLabel = { admin: 'Administrador', tecnico: 'Técnico', cliente: 'Cliente' }[perfilUser] || perfilUser; %>

  <div class="user-profile">
    <div class="avatar-circle"><%= nomeUser.charAt(0).toUpperCase() %></div>
    <div class="user-info">
      <span class="user-name"><%= nomeUser %></span>
      <span class="user-role"><%= perfilLabel %></span>
    </div>
  </div>
</header>
