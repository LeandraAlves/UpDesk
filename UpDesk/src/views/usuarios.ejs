<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários - UpDesk</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { paginaAtiva: 'usuarios' }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar') %>

      <main class="content-area">
        <div class="page-header">
          <div>
            <h1 class="page-title">Usuários</h1>
            <p class="page-subtitle">Cadastre e gerencie os acessos da equipe e clientes.</p>
          </div>
        </div>
        <% if (sucesso === 'excluido') { %><div class="card" role="status">Usuário excluído com sucesso.</div><% } %>
        <% if (sucesso === 'criado') { %><div class="card" role="status">Usuário cadastrado com sucesso.</div><% } %>

        <div class="split-grid">
          <div class="card">
            <form action="/usuarios" method="GET" class="filter-panel">
              <label class="form-label" for="busca-usuario">Pesquisar usuários</label>
              <div class="form-actions">
                <input id="busca-usuario" name="busca" class="form-control" type="search" value="<%= busca %>" placeholder="Nome ou e-mail">
                <button type="submit" class="btn btn-primary">Pesquisar</button>
                <a href="/usuarios" class="btn btn-secondary">Limpar</a>
              </div>
            </form>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Perfil</th>
                    <th>Tipo de usuário</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof usuarios !== 'undefined' && usuarios.length > 0) { %>
                    <% usuarios.forEach(u => { %>
                      <tr>
                        <td><%= u.id %></td>
                        <td><strong><%= u.nome %></strong></td>
                        <td style="color:#64748b;"><%= u.email %></td>
                        <td>
                          <% if (u.perfil === 'admin') { %>
                            <span class="badge badge-info">Admin</span>
                          <% } else if (u.perfil === 'cliente') { %>
                            <span class="badge badge-warning">Cliente</span>
                          <% } else if (u.perfil === 'tecnico') { %>
                            <span class="badge badge-neutral">Técnico</span>
                          <% } else { %>
                            <span class="badge badge-neutral"><%= u.perfil %></span>
                          <% } %>
                        </td>
                        <td><%= u.tipoUsuario ? u.tipoUsuario.nome : 'Sem tipo definido' %></td>
                        <td>
                          <% if (u.id !== usuario.id) { %>
                            <form action="/usuarios/excluir/<%= u.id %>" method="POST" onsubmit="return confirm('Excluir este usuário?')">
                              <button type="submit" class="btn-danger-icon">🗑️ Excluir</button>
                            </form>
                          <% } else { %><span class="text-muted">Conta atual</span><% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" style="text-align:center; padding:32px; color:#64748b;">Nenhum usuário encontrado.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card" style="border-top: 4px solid #1a73e8;">
            <h2 class="card-title">Novo Usuário</h2>
            <form action="/usuarios/cadastrar" method="POST">
              <div class="form-group">
                <label class="form-label">Nome do Usuário <span class="req">*</span></label>
                <input type="text" name="nome" class="form-control" maxlength="255" placeholder="Nome completo" required>
              </div>

              <div class="form-group">
                <label class="form-label">E-mail <span class="req">*</span></label>
                <input type="email" name="email" class="form-control" maxlength="255" placeholder="email@empresa.com" required>
              </div>

              <div class="form-group">
                <label class="form-label">Senha <span class="req">*</span></label>
                <input type="password" name="senha" class="form-control" minlength="8" placeholder="Senha de acesso" required>
              </div>

              <div class="form-group">
                <label class="form-label">Perfil <span class="req">*</span></label>
                <select name="perfil" id="perfilSelect" class="form-control" required onchange="verificarTipoUsuario()">
                  <option value="">Selecione o Perfil...</option>
                  <option value="tecnico">Técnico</option>
                  <option value="admin">Admin</option>
                  <option value="cliente">Cliente</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">Tipo de usuário <span class="req">*</span></label>
                <select name="tipoUsuarioId" id="tipoUsuarioSelect" class="form-control" required onchange="verificarTipoUsuario()">
                  <option value="">Selecione o tipo de usuário...</option>
                  <% if (typeof tiposUsuario !== 'undefined') { %>
                    <% tiposUsuario.forEach(tipoUsuario => { %>
                      <option value="<%= tipoUsuario.id %>" data-nome="<%= tipoUsuario.nome.trim().toLowerCase() %>"><%= tipoUsuario.nome %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="form-group" id="campoDepartamento" style="display: none;">
                <label class="form-label">Departamento</label>
                <select name="departamentoId" id="departamentoSelect" class="form-control" disabled>
                  <option value="">Selecione o Departamento...</option>
                  <% if (typeof departamentos !== 'undefined') { %>
                    <% departamentos.forEach(dep => { %>
                      <option value="<%= dep.id %>"><%= dep.nome %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <button type="submit" class="btn btn-primary" style="width:100%; margin-top:12px; padding: 12px;">💾 Salvar Usuário</button>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    function verificarTipoUsuario() {
      const tipoUsuarioSelect = document.getElementById('tipoUsuarioSelect');
      const selectedOption = tipoUsuarioSelect.options[tipoUsuarioSelect.selectedIndex];
      const nomeTipoUsuario = (selectedOption.getAttribute('data-nome') || '').trim().toLowerCase();
      const perfil = document.getElementById('perfilSelect').value;
      const campoDep = document.getElementById('campoDepartamento');
      const departamentoSelect = document.getElementById('departamentoSelect');
      const semDepartamento = perfil === 'cliente' ||
        (perfil !== 'tecnico' && ['cliente', 'gerencia'].includes(nomeTipoUsuario));

      campoDep.style.display = semDepartamento ? 'none' : 'block';
      departamentoSelect.disabled = semDepartamento;
      if (semDepartamento) {
        departamentoSelect.value = '';
      }
    }
  </script>
</body>
</html>
