<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários - UpDesk</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { paginaAtiva: 'usuarios' }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar') %>

      <main class="content-area">
        <div class="page-header">
          <div>
            <h1 class="page-title">Usuários</h1>
            <p class="page-subtitle">Cadastre e gerencie os acessos da equipe e clientes.</p>
          </div>
        </div>

        <div class="split-grid">
          <!-- Tabela de Usuários (Esquerda) -->
          <div class="card">
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Perfil</th>
                    <th>Categoria</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof usuarios !== 'undefined' && usuarios.length > 0) { %>
                    <% usuarios.forEach(u => { %>
                      <tr>
                        <td><%= u.id %></td>
                        <td><strong><%= u.nome %></strong></td>
                        <td style="color:#64748b;"><%= u.email %></td>
                        <td>
                          <% if (u.perfil === 'admin') { %>
                            <span class="badge badge-info">Admin</span>
                          <% } else if (u.perfil === 'cliente') { %>
                            <span class="badge badge-warning">Cliente</span>
                          <% } else { %>
                            <span class="badge badge-neutral">Usuário</span>
                          <% } %>
                        </td>
                        <td><%= u.categoria ? u.categoria.nome : 'Sem categoria' %></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" style="text-align:center; padding:32px; color:#64748b;">Nenhum usuário cadastrado.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Painel Lateral Novo Usuário (Direita) -->
          <div class="card" style="border-top: 4px solid #1a73e8;">
            <h2 class="card-title">Novo Usuário</h2>
            <form action="/usuarios/cadastrar" method="POST">
              <div class="form-group">
                <label class="form-label">Nome do Usuário <span class="req">*</span></label>
                <input type="text" name="nome" class="form-control" placeholder="Nome completo" required>
              </div>

              <div class="form-group">
                <label class="form-label">E-mail <span class="req">*</span></label>
                <input type="email" name="email" class="form-control" placeholder="email@empresa.com" required>
              </div>

              <div class="form-group">
                <label class="form-label">Senha <span class="req">*</span></label>
                <input type="password" name="senha" class="form-control" placeholder="Senha de acesso" required>
              </div>

              <div class="form-group">
                <label class="form-label">Perfil <span class="req">*</span></label>
                <select name="perfil" class="form-control" required>
                  <option value="">Selecione o Perfil...</option>
                  <option value="usuario">Usuário</option>
                  <option value="admin">Admin</option>
                  <option value="cliente">Cliente</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">Categoria <span class="req">*</span></label>
                <select name="categoriaId" id="categoriaSelect" class="form-control" required onchange="verificarCategoria(this)">
                  <option value="">Selecione a Categoria...</option>
                  <% if (typeof categorias !== 'undefined') { %>
                    <% categorias.forEach(cat => { %>
                      <option value="<%= cat.id %>" data-nome="<%= cat.nome.trim().toLowerCase() %>"><%= cat.nome %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="form-group" id="campoDepartamento" style="display: none;">
                <label class="form-label">Departamento</label>
                <select name="departamentoId" class="form-control">
                  <option value="">Selecione o Departamento...</option>
                  <% if (typeof departamentos !== 'undefined') { %>
                    <% departamentos.forEach(dep => { %>
                      <option value="<%= dep.id %>"><%= dep.nome %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <button type="submit" class="btn btn-primary" style="width:100%; margin-top:12px; padding: 12px;">💾 Salvar Usuário</button>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    function verificarCategoria(select) {
      const selectedOption = select.options[select.selectedIndex];
      const nomeCategoria = selectedOption.getAttribute('data-nome');
      const campoDep = document.getElementById('campoDepartamento');

      if (nomeCategoria && nomeCategoria !== 'gerencia') {
        campoDep.style.display = 'block';
      } else {
        campoDep.style.display = 'none';
      }
    }
  </script>
</body>
</html>
