<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários - UpDesk</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { paginaAtiva: 'usuarios' }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar') %>

      <main class="content-area">
        <div class="page-header">
          <div>
            <h1 class="page-title">Usuários</h1>
            <p class="page-subtitle">Cadastre e gerencie os acessos da equipe e clientes.</p>
          </div>
        </div>
        <% if (sucesso === 'excluido') { %><div class="card" role="status">Usuário excluído com sucesso.</div><% } %>
        <% if (sucesso === 'criado') { %><div class="card" role="status">Usuário cadastrado com sucesso.</div><% } %>
        <% if (sucesso === 'editado') { %><div class="card" role="status">Usuário atualizado com sucesso.</div><% } %>

        <div class="split-grid">
          <div class="card">
            <form action="/usuarios" method="GET" class="filter-panel">
              <label class="form-label" for="busca-usuario">Pesquisar usuários</label>
              <div class="form-actions">
                <input id="busca-usuario" name="busca" class="form-control" type="search" value="<%= busca %>" placeholder="Nome ou e-mail">
                <button type="submit" class="btn btn-primary">Pesquisar</button>
                <a href="/usuarios" class="btn btn-secondary">Limpar</a>
              </div>
            </form>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Perfil</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof usuarios !== 'undefined' && usuarios.length > 0) { %>
                    <% usuarios.forEach(u => { %>
                      <tr>
                        <td><%= u.id %></td>
                        <td><strong><%= u.nome %></strong></td>
                        <td style="color:#64748b;"><%= u.email %></td>
                        <td>
                          <% if (u.perfil === 'admin') { %>
                            <span class="badge badge-info">Admin</span>
                          <% } else if (u.perfil === 'cliente') { %>
                            <span class="badge badge-warning">Cliente</span>
                          <% } else if (u.perfil === 'tecnico') { %>
                            <span class="badge badge-neutral">Técnico</span>
                          <% } else { %>
                            <span class="badge badge-neutral"><%= u.perfil %></span>
                          <% } %>
                        </td>
                        <td>
                          <a href="/usuarios/editar/<%= u.id %>" class="btn btn-secondary btn-sm">Editar</a>
                          <% if (u.id !== usuario.id) { %>
                            <form action="/usuarios/excluir/<%= u.id %>" method="POST" onsubmit="return confirm('Excluir este usuário?')">
                              <button type="submit" class="btn-danger-icon">🗑️ Excluir</button>
                            </form>
                          <% } else { %><span class="text-muted">Conta atual</span><% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" style="text-align:center; padding:32px; color:#64748b;">Nenhum usuário encontrado.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card" style="border-top: 4px solid #1a73e8;">
            <h2 class="card-title"><%= usuarioEdicao ? 'Editar Usuário' : 'Novo Usuário' %></h2>
            <form action="<%= usuarioEdicao ? `/usuarios/editar/${usuarioEdicao.id}` : '/usuarios/cadastrar' %>" method="POST">
              <div class="form-group">
                <label class="form-label">Nome do Usuário <span class="req">*</span></label>
                <input type="text" name="nome" class="form-control" maxlength="255" placeholder="Nome completo" value="<%= usuarioEdicao ? usuarioEdicao.nome : '' %>" required>
              </div>

              <div class="form-group">
                <label class="form-label">E-mail <span class="req">*</span></label>
                <input type="email" name="email" class="form-control" maxlength="255" placeholder="email@empresa.com" value="<%= usuarioEdicao ? usuarioEdicao.email : '' %>" required>
              </div>

              <div class="form-group">
                <label class="form-label">Senha <% if (!usuarioEdicao) { %><span class="req">*</span><% } %></label>
                <input type="password" name="senha" class="form-control" minlength="8" placeholder="<%= usuarioEdicao ? 'Deixe em branco para manter a senha atual' : 'Senha de acesso' %>" <%= usuarioEdicao ? '' : 'required' %>>
              </div>

              <div class="form-group">
                <label class="form-label">Perfil <span class="req">*</span></label>
                <select name="perfil" id="perfilSelect" class="form-control" required onchange="verificarPerfil()">
                  <option value="">Selecione o Perfil...</option>
                  <option value="tecnico" <%= usuarioEdicao && usuarioEdicao.perfil === 'tecnico' ? 'selected' : '' %>>Técnico</option>
                  <option value="admin" <%= usuarioEdicao && usuarioEdicao.perfil === 'admin' ? 'selected' : '' %>>Admin</option>
                  <option value="cliente" <%= usuarioEdicao && usuarioEdicao.perfil === 'cliente' ? 'selected' : '' %>>Cliente</option>
                </select>
              </div>

              <div class="form-group" id="campoDepartamento" style="display: none;">
                <label class="form-label">Departamento</label>
                <select name="departamentoId" id="departamentoSelect" class="form-control" disabled>
                  <option value="">Selecione o Departamento...</option>
                  <% if (typeof departamentos !== 'undefined') { %>
                    <% departamentos.forEach(dep => { %>
                      <option value="<%= dep.id %>" <%= usuarioEdicao && usuarioEdicao.departamentoId === dep.id ? 'selected' : '' %>><%= dep.nome %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <button type="submit" class="btn btn-primary" style="width:100%; margin-top:12px; padding: 12px;"><%= usuarioEdicao ? 'Salvar alterações' : '💾 Salvar Usuário' %></button>
              <% if (usuarioEdicao) { %><a href="/usuarios" class="btn btn-secondary" style="display:block; text-align:center; margin-top:8px;">Cancelar</a><% } %>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    function verificarPerfil() {
      const perfil = document.getElementById('perfilSelect').value;
      const campoDep = document.getElementById('campoDepartamento');
      const departamentoSelect = document.getElementById('departamentoSelect');
      const precisaDepartamento = perfil === 'tecnico';

      campoDep.style.display = precisaDepartamento ? 'block' : 'none';
      departamentoSelect.disabled = !precisaDepartamento;
      departamentoSelect.required = precisaDepartamento;
      if (!precisaDepartamento) {
        departamentoSelect.value = '';
      }
    }

    verificarPerfil();
  </script>
</body>
</html>
