<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Categorias - UpDesk</title>
</head>
<body>

  <h1>Gestão do Sistema</h1>

  <div>
    Bem-vindo, <strong><%= usuario.nome %></strong> (<%= usuario.perfil %>) | 
    <a href="/inicio">Início</a> | 
    <a href="/autenticacao/logout">Sair</a>
  </div>

  <br>

  <nav>
    <a href="/categorias">Categorias</a> | 
    <a href="/departamentos">Departamentos</a> | 
    <a href="/usuarios">Usuários</a> | 
    <a href="/chamados">Chamados</a>
  </nav>

  <hr>

  <h2>Nova Categoria</h2>

  <form action="/categorias/cadastrar" method="POST">
    <div>
      <input type="text" name="nome" placeholder="Nome da Categoria" required>
    </div>
    <div>
      <input type="text" name="descricao" placeholder="Descrição (Opcional)">
    </div>
    <button type="submit">Salvar</button>
  </form>

  <hr>

  <h2>Categorias Cadastradas</h2>

  <table border="1">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Descrição</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% categorias.forEach(cat => { %>
        <tr>
          <td><%= cat.id %></td>
          <td><%= cat.nome %></td>
          <td><%= cat.descricao || '-' %></td>
          <td>
            <a href="/categorias/excluir/<%= cat.id %>" onclick="return confirm('Tens a certeza que pretendes excluir esta categoria?')">Excluir</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</body>
</html>