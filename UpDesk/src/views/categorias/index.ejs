<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Gestão de Categorias</title>
</head>
<body>

  <h1>Gestão do Sistema</h1>
  
  <div>
    <% if (typeof usuario !== 'undefined' && usuario) { %>
      Bem-vindo, <strong><%= usuario.nome %></strong> (<%= usuario.perfil %>) | 
    <% } else { %>
      Bem-vindo, <strong>Gerencia</strong> (admin) | 
    <% } %>
    <a href="/autenticacao/logout">Sair</a>
  </div>

  <!-- Menu de navegação global -->
  <nav>
    <a href="/categorias">Categorias</a> | 
    <a href="/departamentos">Departamentos</a>
  </nav>

  <hr>

  <!-- Seção de Cadastro -->
  <h2>Nova Categoria</h2>
  <form action="/categorias/novo" method="POST">
    <div>
      <input type="text" name="nome" placeholder="Nome da Categoria" required />
    </div>
    <div>
      <input type="text" name="descricao" placeholder="Descrição (Opcional)" />
    </div>
    <div>
      <button type="submit">Salvar</button>
    </div>
  </form>

  <hr>

  <!-- Seção de Listagem -->
  <h2>Categorias Cadastradas</h2>
  <table border="1">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Descrição</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (typeof categorias !== 'undefined' && categorias.length > 0) { %>
        <% categorias.forEach(cat => { %>
          <tr>
            <td><%= cat.id %></td>
            <td><%= cat.nome %></td>
            <td><%= cat.descricao || '-' %></td>
            <td>-</td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="4">Nenhuma categoria cadastrada.</td>
        </tr>
      <% } %>
    </tbody>
  </table>

</body>
</html>