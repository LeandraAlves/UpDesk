<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fila de atendimento - UpDesk</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { paginaAtiva: 'ti' }) %>
    <div class="main-wrapper">
      <%- include('partials/topbar') %>
      <main class="content-area">
        <div class="page-header">
          <div>
            <h1 class="page-title">Fila de atendimento</h1>
            <p class="page-subtitle"><%= usuario.perfil === 'tecnico' ? 'Chamados abertos do seu departamento.' : 'Chamados abertos aguardando atribuição.' %></p>
          </div>
        </div>
        <form action="/ti/chamados-abertos" method="GET" class="card filter-panel">
          <div class="filter-grid">
            <div class="form-group">
              <label class="form-label" for="busca-fila">Pesquisar</label>
              <input id="busca-fila" name="busca" class="form-control" type="search" value="<%= filtros.busca %>" placeholder="Título, descrição ou número">
            </div>
            <div class="form-group">
              <label class="form-label" for="prioridade-fila">Gravidade</label>
              <select id="prioridade-fila" name="prioridade" class="form-control">
                <option value="">Todas</option>
                <% [['baixa','Baixa'],['media','Média'],['alta','Alta']].forEach(([valor,rotulo]) => { %><option value="<%= valor %>" <%= filtros.prioridade === valor ? 'selected' : '' %>><%= rotulo %></option><% }) %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="categoria-fila">Categoria</label>
              <select id="categoria-fila" name="categoriaId" class="form-control">
                <option value="">Todas</option>
                <% categorias.forEach(categoria => { %><option value="<%= categoria.id %>" <%= filtros.categoriaId === String(categoria.id) ? 'selected' : '' %>><%= categoria.nome %></option><% }) %>
              </select>
            </div>
            <% if (usuario.perfil === 'admin') { %>
              <div class="form-group">
                <label class="form-label" for="departamento-fila">Departamento</label>
                <select id="departamento-fila" name="departamentoId" class="form-control">
                  <option value="">Todos</option>
                  <% departamentos.forEach(departamento => { %><option value="<%= departamento.id %>" <%= filtros.departamentoId === String(departamento.id) ? 'selected' : '' %>><%= departamento.nome %></option><% }) %>
                </select>
              </div>
            <% } %>
          </div>
          <div class="filter-actions">
            <a href="/ti/chamados-abertos" class="btn btn-secondary">Limpar</a>
            <button type="submit" class="btn btn-primary">Filtrar fila</button>
          </div>
        </form>
        <section class="card">
          <div class="table-responsive">
            <table class="data-table">
              <thead><tr><th>#</th><th>Título</th><th>Solicitante</th><th>Categoria</th><th>Departamento</th><th>Gravidade</th><th>Status</th><th>Ação</th></tr></thead>
              <tbody>
                <% if (chamadosAbertos.length) { %>
                  <% chamadosAbertos.forEach(chamado => { %>
                    <tr>
                      <td>#<%= String(chamado.id).padStart(3, '0') %></td>
                      <td><strong><%= chamado.titulo %></strong></td>
                      <td><%= chamado.solicitante ? chamado.solicitante.nome : '—' %></td>
                      <td><%= chamado.categoria ? chamado.categoria.nome : '—' %></td>
                      <td><%= chamado.departamento ? chamado.departamento.nome : '—' %></td>
                      <td><%= chamado.prioridade %></td>
                      <td><span class="badge badge-info">Em aberto</span></td>
                      <td>
                        <% if (usuario.perfil === 'tecnico') { %>
                          <form action="/chamados/<%= chamado.id %>/assumir" method="POST"><button type="submit" class="btn btn-primary btn-sm">Assumir</button></form>
                        <% } else { %><a href="/chamados/<%= chamado.id %>" class="btn btn-secondary btn-sm">Detalhes</a><% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %><tr><td colspan="8" class="table-empty">Nenhum chamado aberto neste departamento.</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </div>
</body>
</html>
